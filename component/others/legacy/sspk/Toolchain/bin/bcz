#!/bin/bash
##################################################################################
#
#  Copyright (c) Microsoft Corporation.  All Rights Reserved.
#
##################################################################################

#export MSPK_FLAVOR="chk" 
export MSPK_FLAVOR="shp" 
export MSPK_PLATFORM="LinuxSample" 
export MSPK_ROOT=$SSPK_TOP_DIR
export MSPK_TOOLCHAIN=$SSPK_TOP_DIR/Toolchain
export MSPK_OUTPUT="$MSPK_ROOT/output"
echo "MSPK_ROOT is $MSPK_ROOT"
echo "MSPK_TOOLCHAIN is $MSPK_TOOLCHAIN"

if [ "$MSPK_OUTPUT" == "" ]
then
	export MSPK_OUTPUT=$HOME/output
fi

if [ -f $MSPK_ROOT/Platform/$MSPK_PLATFORM/bin/bcz ]
then
	$MSPK_ROOT/Platform/$MSPK_PLATFORM/bin/bcz $*
	exit 0
fi

#
# See if we want to build multiple platforms
#
if [ "$MSPK_MULTIFLAVOR" == "" ]
then
	if [ "$MSPK_FLAVOR" == "" ]
	then
		export MSPK_MULTIFLAVOR="chk"
	else
		export MSPK_MULTIFLAVOR="$MSPK_FLAVOR"
	fi
fi

echo cleaning output

#
# Build each flavor
#
for MSPK_FLAVOR in $MSPK_MULTIFLAVOR
do
	#
	# We don't need the MSPK_ prefix on this because it's being set
	# inside a BASH script, so the variable's life ends when the
	# script ends
	#
	export OUTPUT_ROOT="$MSPK_OUTPUT/$MSPK_PLATFORM/$MSPK_FLAVOR"
	rm -r -f "$OUTPUT_ROOT"
done

echo building
$SSPK_TOP_DIR/Toolchain/bin/bz $*

