#!/bin/bash
##################################################################################
#
#  Copyright (c) Microsoft Corporation.  All Rights Reserved.
#
##################################################################################
export MSPK_FLAVOR="chk" 
#export MSPK_FLAVOR="shp" 
export MSPK_PLATFORM="LinuxSample" 
export MSPK_ROOT=$SSPK_TOP_DIR
export MSPK_TOOLCHAIN=$SSPK_TOP_DIR/Toolchain
export MSPK_OUTPUT=$SSPK_TOP_DIR/output
export MSPK_OUTPUT_INSTALL=$SSPK_OUTPUT_PATH/sspk
#
# Find the base path of the output
#
if [ "$MSPK_OUTPUT" == "" ]
then
	export MSPK_OUTPUT=$HOME/output
fi

#
# If the platform provides their own build script, use
# it instead
#
if [ -f $MSPK_ROOT/Platform/$MSPK_PLATFORM/bin/bz ]
then
	$MSPK_ROOT/Platform/$MSPK_PLATFORM/bin/bz $*
	exit 0
fi

#
# See if we want to build multiple platforms
#
if [ "$MSPK_MULTIFLAVOR" == "" ]
then
	if [ "$MSPK_FLAVOR" == "" ]
	then
		export MSPK_MULTIFLAVOR="chk"
	else
		export MSPK_MULTIFLAVOR="$MSPK_FLAVOR"
	fi
fi

#
# Build each flavor
#
for MSPK_FLAVOR in $MSPK_MULTIFLAVOR
do
	#
	# We don't need the MSPK_ prefix on this because it's being set
	# inside a BASH script, so the variable's life ends when the
	# script ends
	#
	export OUTPUT_ROOT=$MSPK_OUTPUT/$MSPK_PLATFORM/$MSPK_FLAVOR

	mkdir -p $OUTPUT_ROOT

	buildlog=$OUTPUT_ROOT/build.log
	builderr=$OUTPUT_ROOT/build.err

	#
	# Create a couple FIFO's (named pipes) to capture various output.
	# We're going to use stdout_pipe$$ to capture the standard output
	# of the make, and stderr_pipe$$ to capture the standard error of the
	# make.
	#
	# The standard output will go to the build log file, the standard error
	# will go to the build error file, and another copy of the standard
	# error will go to the screen, and a 3rd copy will go to the build log file.
	#
	stderr_pipe=$OUTPUT_ROOT/stderr_pipe$$
	stdout_pipe=$OUTPUT_ROOT/stdout_pipe$$
	mkfifo $stderr_pipe
	mkfifo $stdout_pipe

	#
	# Take everything that's being sent to the stderr pipe, and save
	# it in a build.err file, and then send it to the stdout pipe as
	# well
	#
	tee $builderr < $stderr_pipe 1> $stdout_pipe &
	tpid1=$!

	#
	# Take everything that's being sent to the stdout pipe, and save
	# it in a build.log file, and send it to the REAL stdout as well
	#
	tee $buildlog < $stdout_pipe &
	tpid2=$!

	#
	# Write out the environment to the build log
	#


	#
	# Build, redirecting output to stdout_pipe$$ and error to stderr_pipe$$
	#
	make -f makefile.pk VTARGET=mspk_all 1> $stdout_pipe 2> $stderr_pipe

	#
	# Wait until the "tee" processes are done (s.b. less than
	# a split second if anything)
	#
	wait $tpid1
	wait $tpid2

	#
	# Delete the pipes
	#
	rm $stderr_pipe
	rm $stdout_pipe

	#
	# Summary
	#
	echo -e The output is at: \\0033[`echo "$LS_COLORS" | sed "s/^.*so=\([^:]*\).*$/\1/g"`m$OUTPUT_ROOT\\0033[00m
	echo -e The build log can be found at: \\0033[`echo "$LS_COLORS" | sed "s/^.*so=\([^:]*\).*$/\1/g"`m$buildlog\\0033[00m

	#
	# if builderr file is nonzero length, display it
	#
	if [ -s $builderr ]
	then
		echo BUILD ERRORS:
		cat $builderr
	else
		echo BUILD SUCCEEDED.
	fi
done



