find . -type f \( \
	-name \*.mk -o \
	-name \*.h -o \
	-name \*.c -o \
	-name \*.cpp -o \
	-name \*.pk -o \
	-name \*.bash -o \
	-name \*.awk -o \
	-name run_all -o \
	-name dirs -o \
	-name version -o \
	-name bz -o -name bcz -o -name bza -o -name bcza -o -name pbza -o -name pbcza \
	\) -exec fromdos -f {} \;




