MSPK_TARGETMODULE = Test
MSPK_TARGETNAME = TLCommon
MSPK_TARGETPATH = Test/Library/Common

MSPK_CDEFINES =                             \
    -DMSPK_USING_STD_TEMPLATE_LIBS          \

MSPK_DBG_CDEFINES =                         \
    -DMCXDEBUG                              \

MSPK_SOURCES =                              \
    cmdLineArgs.cpp                         \
    CPUUtilization.c                        \
    fileUtils.cpp                           \
    PKTestSuite.cpp                         \
    PKTestSuiteUtils.cpp                    \
    DispatchTimer.cpp                       \
    TestStreamerHttp.cpp                    \
    DRMAcquireLicense.cpp                   \

# TODO: this needs StringSafe: loggingWrapper.c

MSPK_INCLUDES =                             \
    $(MSPK_PAL_INCLUDES);                   \
    $(MSPK_TEST_INCLUDES);                  \
    $(MSPK_COMPONENTS_ROOT)/inc;            \
    $(MSPK_COMPONENTS_ROOT)/Utilities;      \

