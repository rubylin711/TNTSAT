MSPK_TARGETNAME = ExecutiveUT
MSPK_TARGETPATH = Test/Apps/Unit/PAL/$(MSPK_TARGETNAME)
MSPK_TARGETTYPE = TEST

MSPK_CDEFINES =

MSPK_SOURCES =                                                                          \
    test.cpp                                                                            \
    Executive_UnitTest_Threads.c                                                        \
    Executive_UnitTest_Semaphores.c                                                     \
    Executive_UnitTest_Locks.c                                                          \
    Executive_UnitTest_Events.c                                                         \
    Executive_UnitTest_Interlocked.c                                                    \
    Executive_UnitTest_Misc.c                                                           \
    Executive_UnitTest_Memory.c                                                         \
    Executive_UnitTest_MemLeak.cpp                                                      \
    main.c                                                                              \

MSPK_PALS_NEEDED=                                                                       \
    MSPK_PAL_EXECUTIVE                                                                  \

MSPK_TARGETLIBS =                                                                       \
    $(MSPK_PAL_TESTFRAMEWORK_LIBS)                                                       \
    $(MSPK_PAL_LIBS)                                                                     \
    $(MSPK_TEST_LIBS)                                                                    \

DYNAMIC_LIBS =                                                                          \
    $(MSPK_PAL_TESTFRAMEWORK_DYNAMIC_LIBS)                                               \

MSPK_INCLUDES =                                                                         \
    $(MSPK_PAL_TESTFRAMEWORK_INCLUDES);                                                  \
    $(MSPK_PAL_INCLUDES);                                                                \
    $(MSPK_TEST_INCLUDES);                                                               \

