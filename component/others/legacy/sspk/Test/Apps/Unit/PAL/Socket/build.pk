MSPK_TARGETNAME = Socket
MSPK_TARGETPATH = Test/Apps/Unit/PAL/$(MSPK_TARGETNAME)
MSPK_TARGETTYPE = TEST

MSPK_CDEFINES = \

MSPK_DBG_CDEFINES = \
	-DMCXDEBUG

MSPK_SOURCES= \
	test.cpp	\
	main.c	\

MSPK_PALS_NEEDED= \
	MSPK_PAL_EXECUTIVE	\
	MSPK_PAL_SOCKETS 	\
  
MSPK_TARGETLIBS = \
	$(MSPK_PAL_TESTFRAMEWORK_LIBS)				\
	$(MSPK_PAL_LIBS)						\
	$(MSPK_TEST_LIBS)					\


MSPK_INCLUDES= \
	$(MSPK_PAL_TESTFRAMEWORK_INCLUDES);		\
	$(MSPK_PAL_INCLUDES);					\
	$(MSPK_TEST_INCLUDES); 					\


DYNAMIC_LIBS= \
	$(MSPK_PAL_TESTFRAMEWORK_DYNAMIC_LIBS)			\
	
