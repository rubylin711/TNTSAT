MSPK_TARGETNAME = ComponentsUnitTests
MSPK_TARGETPATH = Test/Apps/Unit/$(MSPK_TARGETNAME)
MSPK_TARGETTYPE = TEST

MSPK_CDEFINES = \
    -DMSPK_USING_STD_TEMPLATE_LIBS \

MSPK_DBG_CDEFINES = \

MSPK_SOURCES= \
    main.c \
    ComponentsUnitTests.cpp \
    ClockConfigTests.cpp \
    EndianConversionTests.cpp \
    TestExamples.cpp \
    TestSuiteTests.cpp \
    AutoRefPtrTests.cpp \
    ManifestAPITests.cpp \
    ManifestParserTests.cpp \
    ManifestStreamAPITests.cpp \
    ManifestTrackTests.cpp \
    StringUtilsTests.cpp \
    SmoothTransportTests.cpp \
    SmoothTransportDriver.cpp \
    SocketMbrTests.cpp \
    TimeSpanTests.cpp \
    UrlServices.cpp \
    CChunkBufferTests.cpp \

MSPK_PALS_NEEDED= \
    MSPK_PAL_EXECUTIVE \

MSPK_TARGETLIBS = \
    $(MSPK_PAL_TESTFRAMEWORK_LIBS) \
    $(MSPK_PAL_LIBS) \
    $(MSPK_COMPONENT_LIBS) \
    $(MSPK_TEST_LIBS) \

MSPK_INCLUDES= \
    $(MSPK_PAL_TESTFRAMEWORK_INCLUDES); \
    $(MSPK_PAL_INCLUDES); \
    $(MSPK_TEST_INCLUDES); \
    $(MSPK_ROOT)/inc; \
    $(MSPK_ROOT)/Components/inc; \
    $(MSPK_ROOT)/Components/MBR; \
    $(MSPK_ROOT)/Components/MP4Parser; \
    $(MSPK_ROOT)/Components/Receiver; \
    $(MSPK_ROOT)/Components/Renderer; \
    $(MSPK_ROOT)/Components/Socket; \
    $(MSPK_ROOT)/Components/Utilities; \

DYNAMIC_LIBS= \
    $(MSPK_PAL_TESTFRAMEWORK_DYNAMIC_LIBS) \

