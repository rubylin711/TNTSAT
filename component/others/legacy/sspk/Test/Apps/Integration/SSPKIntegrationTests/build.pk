MSPK_TARGETNAME = SSPKIntegrationTest
MSPK_TARGETPATH = Test/Apps/Unit/$(MSPK_TARGETNAME)
MSPK_TARGETTYPE = TEST

MSPK_CDEFINES = \
    -DMSPK_USING_STD_TEMPLATE_LIBS \

MSPK_DBG_CDEFINES = \

MSPK_SOURCES= \
    main.c \
    SSPKIntegrationTests.cpp \
    ExampleTests.cpp \
    ManifestReadyTests.cpp \
    TrackSelectionTests.cpp \
    SelectTracksTests.cpp \
    StreamSelectionTests.cpp \
    FieldDiagnosticCallbackTests.cpp \
    LiveToVodTests.cpp  \
    SparseStreamsTests.cpp \
    STStatusTests.cpp \
    KeyRotationTests.cpp \
    ContentSwitchingTests.cpp \
    PlaystateTests.cpp \
    ContentPlayingTests.cpp \
    ClosedStateTests.cpp \
    OpeningStateTests.cpp \
    MediaEndedTests.cpp \
    DVRWindowTests.cpp \
    FragmentInfoTests.cpp \
    TrackAttributesTests.cpp \
    RedirectionTests.cpp \

MSPK_PALS_NEEDED= \
    MSPK_PAL_EXECUTIVE \

MSPK_TARGETLIBS = \
    $(MSPK_PAL_TESTFRAMEWORK_LIBS) \
    $(MSPK_PAL_LIBS) \
    $(MSPK_COMPONENT_LIBS) \
    $(MSPK_TEST_LIBS) \
    $(MSPK_OBJ_ROOT)/Test/Apps/Integration/SmoothTestLib/$(MSPK_OBJ_TYPE)/SmoothTestLib.$(MSPK_LIB_EXT) \

MSPK_INCLUDES= \
    $(MSPK_PAL_TESTFRAMEWORK_INCLUDES); \
    $(MSPK_PAL_INCLUDES); \
    $(MSPK_TEST_INCLUDES); \
    $(MSPK_ROOT)/inc; \
    $(MSPK_ROOT)/Components/inc;  \
    $(MSPK_ROOT)/Components/Utilities;  \
    $(MSPK_ROOT)/Test/inc;  \
    $(MSPK_ROOT)/Test/Apps/Integration/SmoothTestLib; \

DYNAMIC_LIBS= \
    $(MSPK_PAL_TESTFRAMEWORK_DYNAMIC_LIBS) \

