MSPK_TARGETMODULE = Test
MSPK_TARGETNAME = SmoothTestLib
MSPK_TARGETPATH = Test/Apps/Integration/$(MSPK_TARGETNAME)
MSPK_TARGETTYPE = TEST

MSPK_CDEFINES = \
    -DMSPK_USING_STD_TEMPLATE_LIBS \

MSPK_DBG_CDEFINES = \

MSPK_SOURCES= \
    STWrapper.cpp \
    STUtilities.cpp \
    SSPKHelpers.cpp \

MSPK_PALS_NEEDED= \
    MSPK_PAL_EXECUTIVE \

MSPK_TARGETLIBS= \
    $(MSPK_PAL_TESTFRAMEWORK_LIBS) \
    $(MSPK_PAL_LIBS) \
    $(MSPK_COMPONENT_LIBS) \
    $(MSPK_TEST_LIBS) \

MSPK_INCLUDES= \
    $(MSPK_PAL_INCLUDES); \
    $(MSPK_TEST_INCLUDES); \
    $(MSPK_ROOT)/inc; \
    $(MSPK_ROOT)/Components/inc; \
    $(MSPK_ROOT)/Components/Decoder; \
    $(MSPK_ROOT)/Components/DRM; \
    $(MSPK_ROOT)/Components/MBR; \
    $(MSPK_ROOT)/Components/MP4Parser; \
    $(MSPK_ROOT)/Components/Renderer; \
    $(MSPK_ROOT)/Components/Receiver; \
    $(MSPK_ROOT)/Components/Socket; \
    $(MSPK_ROOT)/Components/Transport; \
    $(MSPK_ROOT)/Components/Utilities; \


DYNAMIC_LIBS= \
    $(MSPK_PAL_TESTFRAMEWORK_DYNAMIC_LIBS) \

