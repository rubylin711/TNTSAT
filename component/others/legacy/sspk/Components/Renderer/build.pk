	$(MSPK_ROOT)/inc; \
	$(MSPK_ROOT)/Components/inc; \
	$(MSPK_ROOT)/Components/Decoder; \
	$(MSPK_ROOT)/Components/Receiver; \
	$(MSPK_ROOT)/Components/Socket; \
	$(MSPK_ROOT)/Components/Utilities; \

