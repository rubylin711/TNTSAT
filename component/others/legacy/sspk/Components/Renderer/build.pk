	Buffer.cpp \
	BufferPool.cpp \
	BufferPoolFactory.cpp \
	CAccessControl.cpp \
	CClockConfiguration.cpp \
	CHalClock.cpp \
	ClockPK.cpp \
	CPipeId.cpp \
	CRendererRaw.cpp \
	CRendererState.cpp \
	CStreamInfo.cpp \
	CTimesliceManager.cpp \

