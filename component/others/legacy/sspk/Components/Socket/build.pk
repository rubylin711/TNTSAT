MSPK_TARGETMODULE = Components
MSPK_TARGETNAME = Socket
MSPK_TARGETPATH = Components/Socket

MSPK_CDEFINES = \
        -DMSPK_USING_STD_TEMPLATE_LIBS \

MSPK_DBG_CDEFINES = \

MSPK_SOURCES = \
        CSocket.cpp \
        CSocketBase.cpp \
        CSocketDiags.cpp \
        CSocketFactory.cpp \
        CSocketRaw.cpp \
        CSocketMbr.cpp \
        CSocketMbrConfiguration.cpp \
        CSocketMbrDiags.cpp \
        CSocketMbrManifest.cpp \
        CSegmentManifestFetcher.cpp \

MSPK_INCLUDES = \
        $(MSPK_PAL_INCLUDES); \
        $(MSPK_ROOT)/inc; \
        $(MSPK_ROOT)/Components/inc; \
        $(MSPK_ROOT)/Components/Decoder; \
        $(MSPK_ROOT)/Components/DRM; \
        $(MSPK_ROOT)/Components/MBR; \
        $(MSPK_ROOT)/Components/MP4Parser; \
        $(MSPK_ROOT)/Components/Renderer; \
        $(MSPK_ROOT)/Components/Receiver; \
        $(MSPK_ROOT)/Components/Streamer; \
        $(MSPK_ROOT)/Components/Utilities; \

