PLATFORM = linux

_DRM_PLAYREADYPK_LIB =      \
    $(_DRM_REFCODE_LIBS)    \

TOP_SRC_DIR = $(PLAYREADY_ROOT)/source

BINFOLDER =

include gnusources

MODULE_NAME = $(TARGETNAME)
C_SRCS = $(SOURCES)

include $(PLAYREADY_DIR)/GNUmakefile.common

INCLUDE_DIRS +=                                  \
    -I.                                          \
    -I..                                         \
    -I$(SRC_DIR)                                 \
    -I$(TOP_SRC_DIR)/blackbox                    \
    -I$(TOP_SRC_DIR)/certs                       \
    -I$(TOP_SRC_DIR)/inc                         \
    -I$(TOP_SRC_DIR)/keyfile                     \
    -I$(TOP_SRC_DIR)/keyfileformat               \
    -I$(TOP_SRC_DIR)/results/checkedin           \
    -I$(TOP_SRC_DIR)/results                     \
    -I$(TOP_SRC_DIR)/ndtinc                      \
    -I$(TOP_SRC_DIR)/oem/ansi/inc                \
    -I$(TOP_SRC_DIR)/oem/common/inc              \
    -I$(TOP_SRC_DIR)/oem/common/hal/oemimpl      \
    -I$(TOP_SRC_DIR)/oem/common/hal/shared       \
    -I$(TOP_SRC_DIR)/oem/common/trustedexec      \
    -I$(TOP_SRC_DIR)/tools/shared/common         \
    -I$(TOP_SRC_DIR)/tools/shared/netio          \
    -I$(TOP_SRC_DIR)/trustedexec/base            \
    -I$(TOP_SRC_DIR)/trustedexec/inc             \
    -I$(TOP_SRC_DIR)/xmr                         \
    -I/home/juzhou/wanda_symphony/montage-tech/sdk/trunk/opensource/out/curl/include \
    -I/home/juzhou/wanda_symphony/montage-tech/sdk/trunk/opensource/out/openssl1.1.0/include \

	

ifneq "" "$(DRM_BUILD_PROFILE)"

REQUIRED_CFLAGS +=                           \
    -DDRM_BUILD_PROFILE=$(DRM_BUILD_PROFILE) \

else

REQUIRED_CFLAGS +=                           \
    -DDRM_BUILD_PROFILE=900                  \

endif

REQUIRED_CFLAGS +=                               \
    -DTARGET_SUPPORTS_UNALIGNED_DWORD_POINTERS=1 \

ifneq "" "$(TARGET_LITTLE_ENDIAN)"
REQUIRED_CFLAGS += -DTARGET_LITTLE_ENDIAN=$(TARGET_LITTLE_ENDIAN)
endif



