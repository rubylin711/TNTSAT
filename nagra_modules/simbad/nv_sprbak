			status = NV_SPR_ERROR;
			goto error;
		}

		ts->recordDmxId = mtSecGetPlatDmxId(tsid);

		DMSG("open record session %d", tsid);
		ts->sessionType = TRANSPORT_SESSION_TYPE_RECORD;
		ts->emi = emi;
		ts->tsPort = MT_UNF_DMX_PORT_BUTT;

