    ts->smpEnabled = smpEnabled;

	if (ts->smpEnabled) {
		ts->smpSetFlag = TRUE;
	}

end:
	WR_UNLOCK(&rwlock);
	TMSG("[Out]SMP:%d", smpEnabled);
	return st;
}

