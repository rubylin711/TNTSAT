	mb.start =  rec_buf_status.u32BufPhyAddr;
	mb.size = rec_buf_status.u32BufSizeAlign;
	mtSecSetProtectBuffer(mb.start, mb.size, MB_REC);
	#endif

	WR_UNLOCK(&rwlock);

	TMSG("SPR Recording Open success!");

	return NV_SPR_NO_ERROR;

#ifndef USE_DMX_RECORDING
stop_record_channel:
