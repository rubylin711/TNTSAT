        }
		DMSG("set bSupportAdvCa=Nagra");
	} else {

	}

	ret = MT_UNF_PVR_RegisterEvent(MT_UNF_PVR_EVENT_REC_DMX_CREATE, MTADP_PVR_CallBack, NULL);
