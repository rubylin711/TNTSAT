########################################################
#
# Montage LZ Uboot - Unified boot environment(bootargs)
#       Support: SPI Nand Flash, RAW Nand Flash, EMMC
#   Not Support: SPI NOR Flash
#
########################################################

#Linux Bootargs and Memory Config

#Fixed 512M: QA requirement
#setenv ddr_size 512

#config bootup ota loader
#bootloader=1

#MMZ Config
#dfb_en=1
if test "$dfb_en" = "1"; then
	# mtfb: 16M@512M
	setenv dfb_mmz mmz=mtfb,0,512M,16M
fi

pip_en=1
#pip4k_en=1
if test "$pip4k_en" != "1"; then
if test "$pip_en" = "1"; then
	setenv pip_mmz mmz=pip,0,442M,62M
fi
fi
if test "$pip4k_en" = "1"; then
	echo "set pip4k mmz"
	setenv pip_mmz mmz=pip,0,528M,140M
fi
#ddr must as the last mmz
#setenv memargs mmz=pcm,0,6M,4M mmz=av,0,254M,188M $pip_mmz $dfb_mmz mmz=ddr,0,170M,84M
#setenv memargs mmz=pcm,0,6M,4M mmz=av,0,254M,188M $pip_mmz $dfb_mmz mmz=pvr0,0,170M,16M mmz=pvr1,0,186M,4M mmz=ddr,0,190M,64M
#PVR buffer will be allocated by Montage-LZ low level driver from ddr zone, if you don't need OTT, please remove "ott0" zone 
setenv memargs mmz=pcm,0,6M,4M mmz=av,0,254M,188M $pip_mmz $dfb_mmz mmz=ott0,0,170M,16M mmz=ddr,0,186M,68M

#Memory Config
#Caution: memory should NOT add into the bootargs!
if test "$ddr_size" = "1024"; then
	setenv memory_extra mem=512M@512M
fi
if test "$ddr_size" = "2048"; then
	setenv memory_extra mem=1536M@512M
fi
if test "$ddr_size" = "4096"; then
	setenv memory_extra mem=1536M@512M mem=2046M@4096M
fi
if test "$OTP_TEE_EN" = "0"; then
	setenv memory mem=42M@6M mem=456M@48M $memory_extra
else
	setenv memory mem=4M@6M mem=456M@48M $memory_extra
fi

setenv fdt_high 0xffffffffffffffff

#Linux MTD EMMC Partition Config
if test "$bootmedia" = "spi_nand"; then
	echo "set spi nand env"
	if test "$flash_size" = "128"; then
		setenv flashparts mtdparts=spi0.0:4M(boot.img),512k(boot.scr),512k(syscfg.scr),3M(reserved1),2M(teeos),2M(tee.dtb),2M(loaderdb),2M(logo),2M(loaderdtb),2M(otaloader),2M(ldrootfs),2M(dtb),16M(kernel),32M(rootfs),46M(usrfs.img),8M(datafs.img),1M(sampledb),-(user)
	else
		setenv flashparts mtdparts=spi0.0:4M(boot.img),512k(boot.scr),512k(syscfg.scr),3M(reserved1),2M(teeos),2M(tee.dtb),2M(loaderdb),8M(logo),2M(loaderdtb),10M(otaloader),12M(ldrootfs),2M(dtb),32M(kernel),64M(rootfs),88M(usrfs.img),8M(datafs.img),1M(sampledb),-(user)
	fi
elif test "$bootmedia" = "pnand"; then
	echo "set pnand env"
	if test "$flash_size" = "128"; then
		setenv flashparts mtdparts=mt_nf:4M(boot.img),512k(boot.scr),512k(syscfg.scr),3M(reserved1),2M(teeos),2M(tee.dtb),2M(loaderdb),2M(logo),2M(loaderdtb),2M(otaloader),2M(ldrootfs),2M(dtb),16M(kernel),32M(rootfs),46M(usrfs.img),8M(datafs.img),1M(sampledb),-(user)
	else
		setenv flashparts mtdparts=mt_nf:4M(boot.img),512k(boot.scr),512k(syscfg.scr),3M(reserved1),2M(teeos),2M(tee.dtb),2M(loaderdb),8M(logo),2M(loaderdtb),10M(otaloader),12M(ldrootfs),2M(dtb),32M(kernel),64M(rootfs),88M(usrfs.img),8M(datafs.img),1M(sampledb),-(user)
	fi
elif test "$bootmedia" = "emmc"; then
	echo "set emmc env"
	setenv flashparts blkdevparts=mmcblk0:4M(dummy),512k(boot.scr),512k(syscfg.scr),3M(reserved1),2M(teeos),2M(tee.dtb),2M(loaderdb),8M(logo),2M(loaderdtb),10M(otaloader),12M(ldrootfs),2M(dtb),32M(kernel),128M(rootfs),128M(usrfs.img),128M(datafs.img),1M(sampledb),-(user)
fi

#appfs env cfg
if test "$bootloader" = "1"; then
	# ota loader has no usrfs!
else
	# ramdisk_flag:1-->use ramdisk 0--> no use,default 0
	#ramdisk_flag=1
	if test "$ramdisk_flag" = "1"; then
		# usrfs: ro squashfs
		setenv nand_usrfs_env apppart=ram1 appfs=squashfs
	else
		# usrfs: spi_nand, pnand
		if test "$flash_size" = "128"; then
			nand_usrfs_rw=0
		else
			nand_usrfs_rw=1
		fi
		if test "$bootmedia" = "emmc"; then
			setenv nand_usrfs_env apppart=mmcblk0p15 appfs=ext4
		else
			if test "$nand_usrfs_rw" = "1"; then
				# usrfs: rw ubifs
				setenv nand_usrfs_env ubi.mtd=14,2048 apppart=ubi1_0 appfs=ubifs
			else
				# usrfs: ro squashfs
				setenv nand_usrfs_env ubi.mtd=14 ubi.block=1,0 apppart=ubiblock1_0 appfs=squashfs
			fi
		fi
	fi
fi

#rootfs env and tee env cfg
if test "$bootmedia" = "emmc"; then
	setenv rootfs_env root=/dev/mmcblk0p14 rootwait rw rootfstype=ext4
	setenv teefs_env teepart=mmcblk0p16 teefstype=ext4
else
	# bootup ota loader
	if test "$bootloader" = "1"; then
		setenv rootfs_env ubi.mtd=10 ubi.block=0,0 root=/dev/ubiblock0_0 rootfstype=squashfs
	else
		if test "$flash_size" = "128"; then
			setenv rootfs_env ubi.mtd=13 ubi.block=0,0 root=/dev/ubiblock0_0 rootfstype=squashfs
		else
			setenv rootfs_env ubi.mtd=13 root=ubi0:rootfs rw rootfstype=ubifs
		fi
		setenv teefs_env teepart=ubi2_0 teefstype=ubifs
	fi
fi

#datafs env cfg
if test "$bootloader" = "1"; then
	# ota loader has no datafs!
else
	setenv datafs_env ubi.mtd=15,2048
fi

#ramdisk flash addr cfg
if test "$ramdisk_flag" = "1"; then
	setenv ramrootfsaddr 0x5000000
	if test "$bootmedia" = "emmc"; then
		setenv ram1addr 0xD000000
		setenv datafs_env
	else
		setenv ram1addr 0x9000000
	fi
	setenv rootfs_env
fi

#fs env cfg
setenv fs_env $rootfs_env $nand_usrfs_env $datafs_env $teefs_env

#Linux bootargs
setenv bootargs $earlycon console=ttynull console=ttyS0 console=ttyUSB0,115200n8 no_console_suspend uboot_tvsys_set sd_wrback_422 mt_msp.sd_wrback_addr=0x1FC00000 mt_msp.freeze_buf_addr=0x1F800000 $memargs $flashparts $fs_env coherent_pool=1M user_debug=0xffffffff irqaffinity=0 page_owner=on swiotlb=noforce vmalloc=1024M chip_version=$chip_version

#syscfg: 4.5M
loadimg 0 0x480000 0x80000 0x03000000; source 0x03000000
if test "$pip_en" = "1"; then
	mt_clock set_rate vdec_clk 576000000
fi

#load HDCP key, please encrypt data first!
if test "$flash_size" = "128"; then
	loadimg 0 0x7F00000 0x200 0x3400000
else
	loadimg 0 0xF100000 0x200 0x3400000
fi
dcache flush
smc 0x42000003 0 0x3400000 

#teeos: 8M-10M
if test "$OTP_TEE_EN" = "1"; then
	#teedtb: load tee dtb(10M~12M), the actual size will not exceed 1M.
	loadimg 0 0xA00000 0x100000 0x3000000
	loadimg 0 0x800000 0x100000 0x3100000
	smc 0x42000001 0x3100000 0x100000 0x3000000
fi

if test "$flash_size" = "128"; then
	#logo: 14M-16M
	logo_size=0x200000
else
	#logo: 14M-22M
	logo_size=0x800000
fi
setenv read_logo loadimg 0 0xE00000 $logo_size 0x16000000
# 352M-380M
if test "$flash_size" = "128"; then
	setenv jpeg_env "setenv avenv_JPEG_SRC_ADDR 0x16000000; setenv avenv_JPEG_SRC_SIZE 0x200000; setenv avenv_JPEG_HEAP_ADDR 0x16200000; setenv avenv_JPEG_HEAP_SIZE 0x1400000"
else
	setenv jpeg_env "setenv avenv_JPEG_SRC_ADDR 0x16000000; setenv avenv_JPEG_SRC_SIZE 0x800000; setenv avenv_JPEG_HEAP_ADDR 0x16800000; setenv avenv_JPEG_HEAP_SIZE 0x1400000"
fi
# 508M
# Caution: avenv_VID_SD_WR_BACK_ADDR & YUV(444/422) MUST be the same as kernel!
# SD YUV444
#setenv vid_env "setenv avenv_VID_SD_WR_BACK_SIZE 0x32a000; setenv avenv_VID_SD_WR_BACK_FIELD_NO 0x4; setenv avenv_VID_SD_WR_BACK_ADDR 0x1FC00000; setenv avenv_SD_ENABLE 1"
# SD YUV422
setenv vid_env "setenv avenv_AVCPU_CONFIG MIN_AV; setenv avenv_VID_SD_WR_BACK_SIZE 0x195000; setenv avenv_VID_SD_WR_BACK_FIELD_NO 0x4; setenv avenv_VID_SD_WR_BACK_ADDR 0x1FC00000; setenv avenv_SD_ENABLE 1"
# 380M-388M
setenv osd_graphic_env "setenv sysenv_CONFIG_BUF_ADDR 0x17C00000; setenv jpgenv_OSD_BUF_ADDR 0x17C00000; setenv jpgenv_OSD_LAYER 5; setenv jpgenv_GRAPHIC_SIZE_WIDTH 1280; setenv jpgenv_GRAPHIC_SIZE_HEIGHT 720; jpeg_logo"
#load sysconfig from sampledb block
loadimg 0 0xf000000 0x100 0x17C00000
run symphony_logo

#ramdisk cfg
if test "$ramdisk_flag" = "1"; then
	#ram0 addr: rd_start(rootfs startaddr) = (B _end - T _text + 0x3200000) (B _end & T _text in System_map)
	setenv rd_start RD_START0
	#ram0 size: rd_size
	setenv rd_size RD_SIZE0

	#ram1 : rd=size@addr(usrfs startaddr = rd_start + rd_size)
	loadimg 0 $ram1addr ram1size ram1start
	setenv bootargs $bootargs rd=ram1size@ram1start,1

	#load rootfs(squashfs) to ram0
	loadimg 0 $ramrootfsaddr $rd_size $rd_start
	setenv bootargs $bootargs initrd=$rd_start,$rd_size
fi

if test "$flash_size" = "128"; then
	#dtb: 22M-24M
	loadimg 0 0x1600000 0x200000 0x03000000

	#Kernel: 24M-40M
	load_uimage 0 0x1800000 0x1000000 0x07600000; dcache flush; bootm 0x07600000 - 0x03000000
else
	if test "$bootloader" = "1"; then
		echo "bootup ota loader"
		#loader dtb: 22M-24M
		loadimg 0 0x1600000 0x200000 0x03000000

		#loader kernel: 24M-34M
		load_uimage 0 0x1800000 0xA00000 0x07600000; dcache flush; bootm 0x07600000 - 0x03000000
	else
		#dtb: 46M-48M
		loadimg 0 0x2E00000 0x200000 0x03000000

		#Kernel: 48M-80M
		kimage_size=0x2000000
		#loadimg 0 0x3000000 $kimage_size 0x07600000; dcache flush; bootm 0x07600000 - 0x03000000
		load_uimage 0 0x3000000 0x2000000 0x07600000; dcache flush; bootm 0x07600000 - 0x03000000
	fi
fi
