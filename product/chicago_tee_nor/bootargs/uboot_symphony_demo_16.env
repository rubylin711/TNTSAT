################################################
#
# Montage LZ Uboot - boot environment(bootargs)
#
################################################

#Linux Bootargs and Memory Config

#MMZ Config
#dfb_en=1
if test "$dfb_en" = "1"; then
	# mtfb: 16M@512M
	setenv dfb_mmz mmz=mtfb,0,512M,16M
fi

#pip_en=1
if test "$pip_en" = "1"; then
	setenv pip_mmz mmz=pip,0,442M,62M
fi

#ddr must as the last mmz
setenv memargs mmz=pcm,0,6M,4M mmz=av,0,254M,188M $pip_mmz $dfb_mmz mmz=ddr,0,170M,84M

#Memory Config
#Caution: memory should NOT add into the bootargs!
if test "$ddr_size" = "1024"; then
	setenv memory_extra mem=512M@512M
fi
if test "$ddr_size" = "2048"; then
	setenv memory_extra mem=1536M@512M
fi
if test "$ddr_size" = "4096"; then
	setenv memory_extra mem=1536M@512M mem=2046M@4096M
fi
if test "$OTP_TEE_EN" = "0"; then
	setenv memory mem=42M@6M mem=456M@48M $memory_extra
else
	setenv memory mem=4M@6M mem=456M@48M $memory_extra
fi

setenv fdt_high 0xffffffffffffffff

#Linux MTD Partition Config
#setenv mtdparts mtdparts=spi0.1:1536k(btinit_uboot),64k(boot.scr),512k(teeos),64k(dtb),4608k(kernel.img),5376k(rootfs),3584k(usrfs.img),512k(datafs.jffs2),128k(logo)
setenv mtdparts mtdparts=spi0.1:1536k(btinit_uboot),64k(boot.scr),640k(teeos),64k(teedtb),64k(dtb),4608k(kernel.img),4352k(rootfs),4672k(usrfs.img),384k(datafs.jffs2)

#Linux bootargs
setenv bootargs $earlycon console=ttynull console=ttyS0 console=ttyUSB0,115200n8 no_console_suspend uboot_tvsys_set sd_wrback_422 mt_msp.sd_wrback_addr=0x1FC00000 mt_msp.freeze_buf_addr=0x1F800000 root=/dev/mtdblock6 rootfstype=squashfs $memargs apppart=mtdblock7 appfs=squashfs teepart=mtdblock8 teefstype=jffs2 $mtdparts coherent_pool=1M user_debug=0xffffffff irqaffinity=0 page_owner=on swiotlb=noforce vmalloc=1024M chip_version=$chip_version

#sys cfg
mt_clock set_rate avcpu_clk 480000000
mt_clock enable avcpu_clk
mt_clk_cfg clk=gra_clk gate=1 rate=576000000
if test "$pip_en" = "1"; then
	mt_clk_cfg clk=vdec_clk gate=1 rate=576000000
else
	mt_clk_cfg clk=vdec_clk gate=1 rate=495000000
fi
mt_clk_cfg clk=jpg_clk gate=1 rate=262000000
mt_clk_cfg clk=png_clk gate=1 rate=262000000
mt_clk_cfg clk=disp_clk gate=1 rate=594000000
mt_clock set_rate disp_vdc_clk 594000000
mt_clock set_rate disp_osdc_clk 262000000
mt_clock set_rate disp_di_clk 288000000
mt_clock enable hdvenc_clk
mt_clock set_rate hdmi_aud_clk 160000000
mt_clock enable sdvenc_clk
mt_clock enable vbi_clk
mt_clk_cfg clk=aout_clk gate=1 rate=288000000
mt_clk_cfg clk=tsi_clk gate=1 rate=262000000
mt_clk_cfg clk=dsc_clk gate=1 rate=262000000
mt_clk_cfg clk=pka_clk gate=1 rate=206000000
mt_clk_cfg clk=dma_clk gate=1 rate=411500000
mt_analog enable avs_cpu
mt_analog enable avs_sys
# enable clock auto gate(after reset modules, before disable modules)
mt_clock autogate
mt_clock disable gpu_clk
mt_clock disable TOP_GPU_CLK
mt_clock disable sdio1_clk
mt_clock disable TOP_SDIO_1_CLK
mt_clock disable sdio0_clk
mt_clock disable TOP_SDIO_0_CLK
mt_clock disable pnand_clk
mt_clock disable TOP_PNAND_CLK
mt_mod disable hal_dai
mt_clock disable ci_clk
mt_clock disable glitchdet_clk
mt_clock disable sechd0_clk
mt_clock disable kdf_clk
mt_clock disable TOP_GLITCH_CLK
mt_clock disable TOP_IFCP_SYS_CLK
mt_clock disable TOP_IFCP_CRYPTO_CLK
mt_clock disable TOP_IFCP_TIMER_CLK
mt_mod disable hal_mac
mt_clock disable gmac_clk
mt_clock disable TOP_GMAC_CLK
usb stop
mt_mod disable hal_usb0
mt_mod disable hal_usb1
mt_clock disable uart1_clk
mt_clock disable i2c1_clk
mt_mod disable hal_smc
mt_clock disable ao_mcu_clk
mt_analog disable pmon_ana
mt_analog disable rng1_ana
mt_analog disable rng2_ana

# teeos & dtb
loadimg 0 0x230000 0x10000 0x3000000
loadimg 0 0x190000 0xA0000 0x3100000
smc 0x42000001 0x3100000 0xA0000 0x3000000

#logo
setenv read_logo loadimg 0 0xfe0000 0x20000 0x16000000
# 352M-374M
setenv jpeg_env "setenv avenv_JPEG_SRC_ADDR 0x16000000; setenv avenv_JPEG_SRC_SIZE 0x200000; setenv avenv_JPEG_HEAP_ADDR 0x16200000; setenv avenv_JPEG_HEAP_SIZE 0x1400000"
# 508M
# Caution: avenv_VID_SD_WR_BACK_ADDR & YUV(444/422) MUST be the same as kernel!
# SD YUV444
#setenv vid_env "setenv avenv_VID_SD_WR_BACK_SIZE 0x32a000; setenv avenv_VID_SD_WR_BACK_FIELD_NO 0x4; setenv avenv_VID_SD_WR_BACK_ADDR 0x1FC00000; setenv avenv_SD_ENABLE 1"
# SD YUV422
setenv vid_env "setenv avenv_AVCPU_CONFIG MIN_AV; setenv avenv_VID_SD_WR_BACK_SIZE 0x195000; setenv avenv_VID_SD_WR_BACK_FIELD_NO 0x4; setenv avenv_VID_SD_WR_BACK_ADDR 0x1FC00000; setenv avenv_SD_ENABLE 1"
# 374M-382M
setenv osd_graphic_env "setenv jpgenv_OSD_BUF_ADDR 0x17600000; setenv jpgenv_OSD_LAYER 5; setenv jpgenv_GRAPHIC_SIZE_WIDTH 1280; setenv jpgenv_GRAPHIC_SIZE_HEIGHT 720; jpeg_logo"
###run symphony_logo

#dtb
loadimg 0 0x240000 0x10000 0x03000000

#kernel
loadimg 0 0x250000 0x480000 0x07600000

dcache flush

bootm 0x07600000 - 0x03000000
