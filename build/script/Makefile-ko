KERNELDIR ?= $(MT_KERNEL_DIR)
PWD := $(shell pwd)

all: prepare_lib
	$(MAKE) -C $(KERNELDIR) M=$(PWD) modules

prepare_lib:
	ar x libsl_hdr.a
	ar x libvf_mw.a
	ar x libvo_fw.a
clean:
	$(MAKE) -C $(KERNELDIR) M=$(PWD) clean
	rm -f ./*.o
