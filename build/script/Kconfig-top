menu "debug support"

choice
	bool "sanitize"
	default MT_SANITIZE_NONE

config MT_SANITIZE
	bool "generic mode asan"
	select MT_BACKTRACE
	select MT_INSTALL_GDBSERVER
	help
	  generic mode address sanitizer
	  restrict
	  1, sanitizer can't detect first global variable of evary c file for underflow
	  https://github.com/google/sanitizers/issues/869
	  https://gcc.gnu.org/bugzilla/show_bug.cgi?id=82501
	  hope gcc 10.3 fix this bug
	  2, sanitizer can't detect use after free while malloc again and
	  the new area cover the the old, because gcc not use lift period for malloc

config MT_SANITIZE_TAG
	bool "tagged mode asan"
	depends on MT_ARCH_AARCH64
	select MT_BACKTRACE
	select MT_INSTALL_GDBSERVER
	help
	  aarch64 software tagged mode address sanitizer

config MT_SANITIZE_THREAD_RACE
	bool "generic mode tsan"
	depends on MT_ARCH_AARCH64
	select MT_BACKTRACE
	select MT_INSTALL_GDBSERVER
	help
	  generic mode thread race sanitizer

config MT_SANITIZE_NONE
	bool "disable sanitizer"

endchoice

comment "please make buildroot_menuconfig to set sanitize option, see tools/sanitizer/readme.txt"
	depends on (MT_SANITIZE || MT_SANITIZE_TAG || MT_SANITIZE_THREAD_RACE)

