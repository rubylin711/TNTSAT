config MT_INSTRUMENT_FUNCTIONS
	bool "instrument functions"
	default n
	help
	  use gcc option -finstrument-functions
	  void __cyg_profile_func_enter(void *this_fn, void *call_site)
	  and
	  void __cyg_profile_func_exit(void *this_fn, void *call_site)
	  will be called at function entry and return
	  this_fn is callee, call_site is caller
	  if you don't want to some functions be traced, you should use no_instrument_function while declare it

config MT_BACKTRACE
	bool "backtrace"
	default y
	help
	  support backtrace api and related gcc option

