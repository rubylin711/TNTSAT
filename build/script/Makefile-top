	wash \
	initramfs \
	kernel kernel_clean kernel_install kernel_uninstall \
	uImage uImage_install uImage_uninstall \
	buildroot_step0 buildroot_step1 buildroot_step2 buildroot_step999 buildroot_clean buildroot_install buildroot_uninstall buildroot_mclean buildroot_minstall buildroot_muninstall \
	check_copy_buildroot_step0 check_copy_buildroot_step1 \
	copy_lib_to_static rm_lib_from_static \
	kware kware_clean kware_install kware_uninstall \
	libc_mt libc_mt_clean libc_mt_install libc_mt_uninstall \
	common common_clean common_install common_uninstall \
	msp msp_clean msp_install msp_uninstall \
	comp comp_clean comp_install comp_uninstall \
	sample sample_clean sample_install sample_uninstall \
	chip-verification chip-verification_clean chip-verification_install chip-verification_uninstall \
	wb wb_clean wb_install wb_uninstall \
