menuconfig:
	@mkdir -p $(MFRS_CFG_MENUCONFIG_PATH)
	@cp -af ${SDK_DIR}/product/configs/$(MFRS_CFG) $(MFRS_CFG_MENUCONFIG_PATH)/.config
	@make menuconfig -C ${SDK_DIR}/build/script/menuconfig ARCH=$(KERNEL_ARCH) CROSS_COMPILE="$(CONFIG_CROSS_COMPILE_KERNEL)" O=$(MFRS_CFG_MENUCONFIG_PATH) KBUILD_KCONFIG=${SDK_DIR}/Kconfig
	@cp -af $(MFRS_CFG_MENUCONFIG_PATH)/.config ${SDK_DIR}/product/configs/$(MFRS_CFG)
	@make syncconfig

menuconfig_clean:
	@rm -rf $(MFRS_CFG_MENUCONFIG_PATH)
	@rm -f $(INCLUDE_DIR)/autoconf-old.h

syncconfig:
	mkdir -p $(MFRS_CFG_MENUCONFIG_PATH)
	cp -af ${SDK_DIR}/product/configs/$(MFRS_CFG) $(MFRS_CFG_MENUCONFIG_PATH)/.config
	make syncconfig -C ${SDK_DIR}/build/script/menuconfig ARCH=$(KERNEL_ARCH) CROSS_COMPILE="$(CONFIG_CROSS_COMPILE_KERNEL)" O=$(MFRS_CFG_MENUCONFIG_PATH) KBUILD_KCONFIG=${SDK_DIR}/Kconfig
ifeq ($(MFRS_CFG_MENUCONFIG_PATH)/autoconf-old.h,$(wildcard $(MFRS_CFG_MENUCONFIG_PATH)/autoconf-old.h))
	@if [ -n "`diff $(MFRS_CFG_MENUCONFIG_PATH)/autoconf-old.h $(MFRS_CFG_MENUCONFIG_PATH)/include/generated/autoconf.h`" ]; then \
		echo -e "\033[32m update $(MFRS_CFG_MENUCONFIG_PATH)/include/generated/autoconf.h, use $(MFRS_CFG) \033[0m"; \
		cp -af $(MFRS_CFG_MENUCONFIG_PATH)/include/generated/autoconf.h $(MFRS_CFG_MENUCONFIG_PATH)/autoconf-old.h; \
	fi
else
	@echo -e "\033[32m create $(MFRS_CFG_MENUCONFIG_PATH)/include/generated/autoconf.h, use $(MFRS_CFG) \033[0m"
	@cp -af $(MFRS_CFG_MENUCONFIG_PATH)/include/generated/autoconf.h $(MFRS_CFG_MENUCONFIG_PATH)/autoconf-old.h
endif
	cp -af $(MFRS_CFG_MENUCONFIG_PATH)/.config ${SDK_DIR}/product/configs/$(MFRS_CFG)

create_config_header: buildroot_step0
	mkdir -p $(INCLUDE_DIR); cd $(INCLUDE_DIR); ln -sf $(MFRS_CFG_MENUCONFIG_PATH)/autoconf-old.h .

destroy_config_header:
	rm -f $(INCLUDE_DIR)/autoconf-old.h

menuconfig_all:
	@./build/script/menuconfig_all.sh
	@make syncconfig

kernel_menuconfig_all:
	@make kernel_syncconfig
	@KERNEL_OUTPUT=$(KERNEL_OUTPUT) MT_KERNEL_DIR=$(MT_KERNEL_DIR) ./build/script/kernel_menuconfig_all.sh
	@make kernel_syncconfig

