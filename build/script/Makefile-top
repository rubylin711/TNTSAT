debug_tools:
ifeq ($(CONFIG_MT_INSTALL_PERF),y)
	make  -C $(COMPONENT_DIR)/others/build_scripts -f 5.set_env_perf.mk
	make  -C $(COMPONENT_DIR)/others/build_scripts -f 5.set_env_perf.mk install
endif
ifeq ($(CONFIG_MT_INSTALL_GPERFTOOLS),y)
	make  -C $(COMPONENT_DIR)/gperftools
endif

debug_tools_install:
ifeq ($(CONFIG_MT_INSTALL_PERF),y)
	make  -C $(COMPONENT_DIR)/others/build_scripts -f 5.set_env_perf.mk install
endif
ifeq ($(CONFIG_MT_INSTALL_GPERFTOOLS),y)
	make  -C $(COMPONENT_DIR)/gperftools install
endif

debug_tools_uninstall:
ifeq ($(CONFIG_MT_INSTALL_PERF),y)
	make  -C $(COMPONENT_DIR)/others/build_scripts -f 5.set_env_perf.mk uninstall
endif
ifeq ($(CONFIG_MT_INSTALL_GPERFTOOLS),y)
	make  -C $(COMPONENT_DIR)/gperftools uninstall
endif

debug_tools_clean:
ifeq ($(CONFIG_MT_INSTALL_PERF),y)
	make  -C $(COMPONENT_DIR)/others/build_scripts -f 5.set_env_perf.mk clean
endif
ifeq ($(CONFIG_MT_INSTALL_GPERFTOOLS),y)
	make  -C $(COMPONENT_DIR)/gperftools clean
endif

common:
	make  -C $(COMMON_DIR) -j$(j)

common_install:
	make  -C $(COMMON_DIR) install

common_uninstall:
	make  -C $(COMMON_DIR) uninstall

common_clean:
	make  -C $(COMMON_DIR) clean

msp:
	make  -C $(MSP_DIR) -j$(j)

msp_install:
	make  -C $(MSP_DIR) install

msp_uninstall:
	make  -C $(MSP_DIR) uninstall

msp_clean:
	make  -C $(MSP_DIR) clean

firmware:
ifeq ($(CFG_MT_CHIP),symphony1)
	cd $(AV_RTOS_DIR); . ./setenv; make firmware_sym1
else ifeq ($(CFG_MT_CHIP),symphony2)
	cd $(AV_RTOS_DIR); . ./setenv; make firmware_sym2
else ifeq ($(CFG_MT_CHIP),symphony4)
	cd $(AV_RTOS_DIR); . ./setenv; make firmware_encrypt
else ifeq ($(CFG_MT_CHIP),symphony6)
	cd $(AV_RTOS_DIR); . ./setenv; make firmware_sym6_encrypt
endif

firmware_encrypt:
	cd $(AV_RTOS_DIR); . ./setenv; make firmware_encrypt

firmware_clean:
	cd $(AV_RTOS_DIR); . ./setenv; make firmware_clean

firmware_install:
	cd $(AV_RTOS_DIR); . ./setenv; make firmware_install

firmware_uninstall:
	cd $(AV_RTOS_DIR); . ./setenv; make firmware_uninstall

mboot:
	make  -C $(MBOOT_DIR) -j1
	make  -f $(CURRENT_MAKEFILES) mboot_install

mboot_install:
	make -C ${SDK_DIR}/build/script -f mboot-install.mk mboot_install

mboot_uninstall:
	make -C ${SDK_DIR}/build/script -f mboot-install.mk mboot_uninstall

mboot_clean:
	make  -C $(MBOOT_DIR) clean
	make  -C $(MBOOT_DIR) uninstall

flash: strip
	@mkdir -p ${SDK_DIR}/image
ifneq ($(CFG_MT_CHIP),aria)
	@rsync -ahL ${SDK_DIR}/product/$(MFRS) ${SDK_DIR}/image
endif
	@make -C ${SDK_DIR}/image/$(MFRS) install
	@make -C ${SDK_DIR}/image/$(MFRS) bin
	@make -C ${SDK_DIR}/image/$(MFRS) update
	@sync

flash_uninstall: strip_uninstall remove_released_files
	@rm -rf ${SDK_DIR}/image/$(MFRS)
	$(AT)if [ "`find ${SDK_DIR}/image -type f`" = "" -a "`find ${SDK_DIR}/image -type l`" = "" ]; then \
		rm -rf ${SDK_DIR}/image; \
	fi

strip: copy_released_files
	@make -C ${SDK_DIR}/build/script -f strip.mk install
	@make -C ${SDK_DIR}/build/script -f strip.mk rootfs
	@make -C ${SDK_DIR}/build/script -f depmod.mk
	@make -C ${SDK_DIR}/build/script -f firmware.mk

strip_uninstall:
	@make -C ${SDK_DIR}/build/script -f strip.mk uninstall

mclean: libc_mt_clean msp_clean common_clean sample_clean nagra_modules_clean  buildroot_mclean debug_tools_clean kware_clean comp_clean mboot_clean menuconfig_clean destroy_config_header
	$(MAKE) -f $(CURRENT_MAKEFILES) kernel_clean

muninstall: libc_mt_uninstall kernel_uninstall uImage_uninstall common_uninstall buildroot_muninstall debug_tools_uninstall msp_uninstall kware_uninstall comp_uninstall sample_uninstall nagra_modules_uninstall  mboot_uninstall

minstall: libc_mt_install kernel_install uImage_install common_install buildroot_minstall debug_tools_install msp_install kware_install comp_install sample_install nagra_modules_install  mboot_install

mall:
	$(MAKE) -f $(CURRENT_MAKEFILES) syncconfig
	$(MAKE) -f $(CURRENT_MAKEFILES) check_copy_buildroot_step0
	$(MAKE) -f $(CURRENT_MAKEFILES) buildroot_step0
	$(MAKE) -f $(CURRENT_MAKEFILES) create_config_header
	$(MAKE) -f $(CURRENT_MAKEFILES) initramfs
	$(MAKE) -f $(CURRENT_MAKEFILES) kernel
	$(MAKE) -f $(CURRENT_MAKEFILES) common
	$(MAKE) -f $(CURRENT_MAKEFILES) buildroot_step1
ifneq ($(CONFIG_MT_PRODUCT_LOADER),y)
	$(MAKE) -f $(CURRENT_MAKEFILES) debug_tools
endif
	$(MAKE) -f $(CURRENT_MAKEFILES) msp
ifneq ($(CONFIG_MT_PRODUCT_LOADER),y)
	$(MAKE) -f $(CURRENT_MAKEFILES) buildroot_step2
endif
	$(MAKE) -f $(CURRENT_MAKEFILES) buildroot_step999
ifneq ($(CONFIG_MT_PRODUCT_LOADER),y)
	$(MAKE) -f $(CURRENT_MAKEFILES) kware
	$(MAKE) -f $(CURRENT_MAKEFILES) comp
endif
	$(MAKE) -f $(CURRENT_MAKEFILES) sample
	$(MAKE) -f $(CURRENT_MAKEFILES) nagra_modules
ifneq ($(CONFIG_MT_PRODUCT_LOADER),y)
	$(MAKE) -f $(CURRENT_MAKEFILES) mboot
endif
	$(MAKE) -f $(CURRENT_MAKEFILES) check_copy_buildroot_step1

mverification:
	$(MAKE) -f $(CURRENT_MAKEFILES) syncconfig
	$(MAKE) -f $(CURRENT_MAKEFILES) check_copy_buildroot_step0
